      "include": [
        {
          "clause": "where",
          "predicate": "compare",
          "axis": "z",
          "op": "lt",
          "value": 32768
        }
      ]
    },
    "device": {
      "device": "44444444444444444444444444444444",
      "quality": "mapped",
      "leds": [
        {
          "index": 0,
          "world": [
            0,
            0,
            0
          ],
          "local": [
            0,
            0,
            0
          ]
        },
        {
          "index": 1,
          "world": [
            0,
            0,
            16384
          ],
          "local": [
            0,
            0,
            0
          ]
        },
        {
          "index": 2,
          "world": [
            0,
            0,
            32768
          ],
          "local": [
            0,
            0,
            0
          ]
        },
        {
          "index": 3,
          "world": [
            0,
            0,
            49152
          ],
          "local": [
            0,
            0,
            0
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "at_us": 0,
      "event": {
        "event": "resolve"
      },
