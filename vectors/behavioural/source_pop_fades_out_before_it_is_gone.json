{
  "schema": 1,
  "kind": "behavioural",
  "machine": "sources",
  "name": "source_pop_fades_out_before_it_is_gone",
  "description": "A popped source leaves the stack immediately but keeps rendering until its fade-out completes, and a second pop for the same id finds nothing. The pusher and the expiry race, and both orders have to be fine.",
  "initial_state": {
    "budget": 100,
    "max_concurrent": 3
  },
  "steps": [
    {
      "at_us": 0,
      "event": {
        "event": "push",
        "id": "e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1",
        "zone": "f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0",
        "scene": "f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1",
        "priority": 100,
        "expires_at_us": 10000000,
        "fade_in_ms": 0,
        "fade_out_ms": 200,
        "cost": 10
      },
      "description": "a show source with a 200 ms fade-out",
      "expect": [
        {
          "action": "admitted",
          "id": "e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1"
        }
      ]
    },
    {
      "at_us": 1000000,
      "event": {
        "event": "pop",
        "id": "e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1"
      },
      "description": "popped: removed from the stack, but still fading",
      "expect": [
        {
          "action": "removed",
          "id": "e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1",
          "reason": "popped"
        }
      ]
    },
    {
      "at_us": 1100000,
      "event": {
        "event": "advance"
      },
      "description": "half way through the fade, nothing has finished",
      "expect": []
    },
    {
      "at_us": 1200000,
      "event": {
        "event": "advance"
      },
      "description": "the fade completes",
      "expect": [
        {
          "action": "fade_finished",
          "id": "e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1"
        }
      ]
    },
    {
      "at_us": 1300000,
      "event": {
        "event": "pop",
        "id": "e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1"
      },
      "description": "popping something already gone is refused, not an error to the caller",
      "expect": [
        {
          "action": "refused",
          "reason": "not_found"
        }
      ]
    }
  ]
}
