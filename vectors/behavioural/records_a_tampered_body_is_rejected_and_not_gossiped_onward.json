          "author": "c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0",
          "body": "7468652d63656c6c617221",
          "signature": "c54aaa9ec1ed08b4ff6c0e04abb3a36a16a1d3d41d9f4da6376a527ef1941edb551988cc724e883f53031e3773e97aea3ce86218e4c65eca7eb0a5cc1fdd2802"
        }
