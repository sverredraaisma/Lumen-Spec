      }
    ],
    "devices": [
      {
        "id": "dadadadadadadadadadadadadadadada",
        "key": "8139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394"
      },
      {
        "id": "dbdbdbdbdbdbdbdbdbdbdbdbdbdbdbdb",
        "key": "ed4928c628d1c2c6eae90338905995612959273a5c63f93636c14614ac8737d1"
      }
    ]
  },
  "steps": [
