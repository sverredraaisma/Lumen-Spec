{
  "schema": 1,
  "kind": "behavioural",
  "machine": "sources",
  "name": "source_push_after_its_expiry_is_refused",
  "description": "A SRC_PUSH that arrives after its own expires_at is refused outright rather than accepted and dropped on the next frame. Accepting it would render it once, which is exactly the visible artefact the rule exists to stop.",
  "initial_state": {
    "budget": 100,
    "max_concurrent": 3
  },
  "steps": [
    {
      "at_us": 1000000,
      "event": {
        "event": "push",
        "id": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "zone": "f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0",
        "scene": "f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1",
        "priority": 100,
        "expires_at_us": 2000000,
        "fade_in_ms": 0,
        "fade_out_ms": 0,
        "cost": 10
      },
      "description": "an ordinary show source, well inside its lease",
      "expect": [
        {
          "action": "admitted",
          "id": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        }
      ]
    },
    {
      "at_us": 3000000,
      "event": {
        "event": "push",
        "id": "a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2",
        "zone": "f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0",
        "scene": "f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1",
        "priority": 100,
        "expires_at_us": 2500000,
        "fade_in_ms": 0,
        "fade_out_ms": 0,
        "cost": 10
      },
      "description": "a push whose expiry is already behind the clock — a late or delayed message. It must never render, not even for the frame it would take to notice",
      "expect": [
        {
          "action": "refused",
          "reason": "already_expired",
          "expires_at_us": 2500000
        }
      ]
    },
    {
      "at_us": 3000000,
      "event": {
        "event": "advance"
      },
      "description": "and it is not on the stack afterwards: only the first source expires",
      "expect": [
        {
          "action": "removed",
          "id": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
          "reason": "expired"
        },
        {
          "action": "fade_finished",
          "id": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        }
      ]
    }
  ]
}
